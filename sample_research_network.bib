@article{vaswani2017attention,
  author = {Vaswani, Ashish and Shazeer, Noam and Parmar, Niki and Uszkoreit, Jakob and Jones, Llion and Gomez, Aidan N. and Kaiser, Lukasz and Polosukhin, Ilya},
  title = {Attention Is All You Need},
  journal = {Advances in Neural Information Processing Systems},
  year = {2017},
  pages = {5998--6008},
  doi = {10.5555/3295222.3295349},
  url = {https://arxiv.org/abs/1706.03762},
  abstract = {The dominant sequence transduction models are based on complex recurrent or convolutional neural networks. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely. We show that these models are superior in quality while being more parallelizable and requiring significantly less time to train. Our model achieves 28.4 BLEU on English-to-German translation and 41.8 BLEU on English-to-French translation, establishing a new state of the art.}
}

@article{devlin2019bert,
  author = {Devlin, Jacob and Chang, Ming-Wei and Lee, Kenton and Toutanova, Kristina},
  title = {BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding},
  journal = {Proceedings of NAACL-HLT},
  year = {2019},
  pages = {4171--4186},
  doi = {10.18653/v1/N19-1423},
  url = {https://arxiv.org/abs/1810.04805},
  abstract = {We introduce a new language representation model called BERT, which stands for Bidirectional Encoder Representations from Transformers. Unlike recent language representation models, BERT is designed to pre-train deep bidirectional representations from unlabeled text by jointly conditioning on both left and right context in all layers. As a result, the pre-trained BERT model can be fine-tuned with just one additional output layer to create state-of-the-art models for a wide range of tasks, such as question answering and language inference, without substantial task-specific architecture modifications.}
}

@article{brown2020gpt3,
  author = {Brown, Tom B. and Mann, Benjamin and Ryder, Nick and Subbiah, Melanie and Kaplan, Jared and Dhariwal, Prafulla and Neelakantan, Arvind and Shyam, Pranav and Sastry, Girish and Askell, Amanda and Sandholm, Valerie and Herbert-Voss, Ariel and Krueger, Gretchen and Henighan, Tom and Child, Rewon and Ramesh, Aditya and Ziegler, Daniel M. and Wu, Jeffrey and Winter, Clemens and Hesse, Christopher and Chen, Mark and Sigler, Benjamin and Litwin, Mateusz and Gray, Scott and Chess, Benjamin and Clark, Jack and Berner, Christopher and McCandlish, Sam and Radford, Alec and Sutskever, Ilya and Amodei, Dario},
  title = {Language Models are Few-Shot Learners},
  journal = {Advances in Neural Information Processing Systems},
  year = {2020},
  pages = {1877--1901},
  doi = {10.5555/3495724.3495883},
  url = {https://arxiv.org/abs/2005.14165},
  abstract = {We demonstrate that scaling up language models greatly improves few-shot performance. We train GPT-3, an autoregressive language model with 175 billion parameters, and evaluate its performance on translation, question-answering, and cloze tasks. GPT-3 achieves strong performance on many NLP datasets without any fine-tuning or gradient updates, performing competitive work with prior state-of-the-art models that utilized fine-tuning.}
}

@article{hu2021lora,
  author = {Hu, Edward J. and Shen, Yaliang and Wallis, Phillip and Allen-Zhu, Zeyuan and Li, Yuanzhi and Wang, Lu and Chen, Weizhu},
  title = {LoRA: Low-Rank Adaptation of Large Language Models},
  journal = {arXiv preprint},
  year = {2021},
  doi = {10.48550/arXiv.2106.09685},
  url = {https://arxiv.org/abs/2106.09685},
  abstract = {We propose Low-Rank Adaptation (LoRA), which freezes the pre-trained model weights and injects trainable rank decomposition matrices into each layer of the Transformer architecture, greatly reducing the number of trainable parameters for downstream tasks. Compared to fine-tuning, LoRA reduces parameter storage by 10,000 times and GPU memory requirements by 3 times, while achieving comparable or superior performance on language modeling tasks.}
}

@article{arute2019quantum,
  author = {Arute, Frank and Arya, Kunal and Babbush, Ryan and Bacon, Dave and Bardin, Joseph C. and Barends, Ramiro and Biswas, Rupak and Boixo, Sergio and Brandao, Fernando and Buell, David A. and Burkett, Brian and Chen, Yu and Chen, Zijun and Chiaro, Ben and Dunsworth, Roberto and Farhi, Edward and Fowler, Austin and Foxen, Craig and Gidney, Craig and Giustina, Marissa and Green, Rob and Havlicek, Klim and Huang, Alan and Kelly, Joey and Klimov, Paul V. and Knysh, Sergey and Korotkov, Alexander and Kostritsa, Fedor and Landhuis, David and Lindmark, Mike and Lucero, Erik and Lyakh, Dmitry and Mandra, Salvatore and McClean, Jarrod R. and McEwen, Matthew and Megrant, Anthony and Mi, Xiao and Michielsen, Kristel and Neill, Charles and Quintana, Chris and Roushan, Pedram and Sank, Daniel and Sastry, Girish and Smelyansky, Vadim and Sung, Kevin and Trevithick, Matthew and White, Amit and Woo, Ted and Yeh, Sherry and Yin, Bing and Zeiger, Alireza and Neven, Hartmut and Martinis, John M.},
  title = {Quantum supremacy using a programmable superconducting processor},
  journal = {Nature},
  year = {2019},
  volume = {574},
  pages = {505--510},
  doi = {10.1038/s41586-019-1666-5},
  abstract = {The promise of quantum computers is that certain computational tasks can be executed exponentially faster on a quantum processor than on a classical processor. We demonstrate quantum supremacy using a programmable superconducting processor with 53 qubits. Our Sycamore processor takes about 200 seconds to sample one instance of a quantum circuit a million times, which would take a classical state-of-the-art supercomputer approximately 10,000 years. This dramatic speedup relative to all known classical algorithms provides an experimental realization of quantum supremacy.}
}

@article{farhi2014qaoa,
  author = {Farhi, Edward and Goldstone, Jeffrey and Gutmann, Sam},
  title = {A Quantum Approximate Optimization Algorithm},
  journal = {arXiv preprint},
  year = {2014},
  doi = {10.48550/arXiv.1411.4028},
  url = {https://arxiv.org/abs/1411.4028},
  abstract = {We introduce a quantum approximate optimization algorithm (QAOA) that runs on shallow quantum circuits. We show how the algorithm can be applied to combinatorial optimization problems like Max-Cut. We analyze the performance of the algorithm on random regular graphs and prove that it yields high-quality approximations. VQAs and QAOA represent the leading paradigm for NISQ quantum computing.}
}

@article{cerezo2021variational,
  author = {Cerezo, Marco and Arrasmith, Andrew and Babbush, Ryan and Benjamin, Simon C. and Endo, Suguru and Fujii, Keisuke and McClean, Jarrod R. and Mitarai, Kosuke and Yuan, Xiao and Lukin, Mikhail and Coles, Patrick J.},
  title = {Variational Quantum Algorithms for Optimization and Machine Learning},
  journal = {Nature Reviews Physics},
  year = {2021},
  volume = {3},
  pages = {625--644},
  doi = {10.1038/s42254-021-00348-9},
  abstract = {Variational quantum algorithms (VQAs) are the most promising candidates for achieving quantum advantage on NISQ devices. These algorithms use a classical optimizer to train a parameterized quantum circuit to minimize a cost function. We review the structure and applications of VQAs, focusing on optimization, machine learning, and quantum chemistry applications, and discuss strategies to overcome challenges like barren plateaus.}
}

@article{mcclean2018barren,
  author = {McClean, Jarrod R. and Boixo, Sergio and Smelyansky, Vadim N. and Babbush, Ryan and Neven, Hartmut},
  title = {Barren Plateaus in Quantum Neural Network Training Landscapes},
  journal = {Nature Communications},
  year = {2018},
  volume = {9},
  pages = {4812},
  doi = {10.1038/s41467-018-07090-4},
  abstract = {We show that for a wide class of reasonable parameterized quantum circuits, the gradient of the objective function vanishes exponentially in the number of qubits. This barren plateau phenomenon severely restricts NISQ training of quantum neural networks and variational algorithms. We analyze the dependence of this effect on the choice of ansatz and propose methods to mitigate it.}
}

@article{corbett2013spanner,
  author = {Corbett, James C. and Dean, Jeffrey and Epstein, Michael and Fikes, Allan and Frost, Christopher and Furman, John J. and Ghemawat, Sanjay and Gubarev, Andrey and Heiser, Christopher and Denikin, Peter and Kanthak, Sebastian and Kroeger, Eugene and Shute, Jeffrey and Tortone, Francisco and Wang, Lu and Zhang, Woody},
  title = {Spanner: Google's Globally Distributed Database},
  journal = {ACM Transactions on Computer Systems},
  year = {2013},
  volume = {31},
  pages = {1--22},
  doi = {10.1145/2491245},
  abstract = {Spanner is Google’s globally distributed database. It is the first system to distribute data at global scale and support externally consistent distributed transactions. Spanner uses Paxos and a hardware-assisted TrueTime API. This API uses GPS receivers and atomic clocks to bound time uncertainty, enabling serializable transaction ordering across multiple data centers.}
}

@article{ongaro2014raft,
  author = {Ongaro, Diego and Ousterhout, John},
  title = {In Search of an Understandable Consensus Algorithm},
  journal = {Proceedings of USENIX ATC},
  year = {2014},
  pages = {305--320},
  url = {https://www.usenix.org/conference/atc14/technical-sessions/presentation/ongaro},
  abstract = {We propose Raft, a consensus algorithm that is designed to be easy to understand. Raft decomposes the consensus problem into three subproblems: leader election, log replication, and safety. Raft offers a stronger form of leadership, simplifies cluster membership changes, and performs comparably to Paxos-based systems.}
}

@article{taft2020cockroachdb,
  author = {Taft, Rebecca and Sharif, Irfan and Matei, Alex and VanBenschoten, Nathan and Lewis, Jordan and Gurevich, Todd and Gruneir, Dan and Mattis, Peter and Kimball, Spencer and McLeod, Benjamin},
  title = {CockroachDB: An Open-Source, Globally-Distributed SQL Database},
  journal = {Proceedings of the VLDB Endowment},
  year = {2020},
  volume = {13},
  pages = {3125--3138},
  doi = {10.14778/3415478.3415538},
  abstract = {CockroachDB is an open-source, globally-distributed SQL database designed to handle transactional workloads with high consistency and survivability. CockroachDB implements Raft consensus for data replication and partition management, and utilizes a decentralized, multi-version transactional model to guarantee serializability across geographical regions.}
}

@article{karger1997consistent,
  author = {Karger, David and Lehman, Eric and Leighton, Tom and Panigrahy, Rina and Levine, Matthew and Lewin, Daniel},
  title = {Consistent Hashing and Random Trees: Distributed Caching Protocols for Relieving Hot Spots on the World Wide Web},
  journal = {Proceedings of ACM STOC},
  year = {1997},
  pages = {654--663},
  doi = {10.1145/258533.258660},
  abstract = {We introduce consistent hashing, a method for routing requests in web caching networks. Consistent hashing minimizes database and network reorganizations when caching nodes (servers) join or leave the network, resolving major load-balancing problems in distributed systems and preventing cascading server failures.}
}
